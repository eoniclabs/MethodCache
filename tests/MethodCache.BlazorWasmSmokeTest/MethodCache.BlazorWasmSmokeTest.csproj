<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Published for the browser in CI (build/ci/jobs.sh wasm) and run in headless Chromium by run.mjs, to prove that
    caching works in a trimmed Blazor WebAssembly app: one thread, no generic host. Not part of the solution.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A trim warning from MethodCache fails the publish, each one listed instead of one summary warning -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <ProjectReference Include="..\..\src\MethodCache.Core\MethodCache.Core.csproj" />
    <ProjectReference Include="..\..\src\MethodCache.SourceGenerator\MethodCache.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
