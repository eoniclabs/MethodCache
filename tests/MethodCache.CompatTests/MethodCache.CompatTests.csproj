<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <ProjectReference Include="../../src/MethodCache.Core/MethodCache.Core.csproj" />
    <!-- Deliberately binary references: ordinary builds/tests never rebuild the vendor baseline. -->
    <Reference Include="FrozenVendor.Contract1" HintPath="Baselines/Contract1/FrozenVendor.Contract1.dll" />
    <Reference Include="FrozenVendor.ThirdParty" HintPath="Baselines/Contract1/FrozenVendor.ThirdParty.dll" />
    <Reference Include="FrozenVendor.Contract1Net10" HintPath="Baselines/Contract1Net10/FrozenVendor.Contract1Net10.dll" />
    <Reference Include="FrozenVendor.ThirdPartyNet10" HintPath="Baselines/Contract1Net10/FrozenVendor.ThirdPartyNet10.dll" />
    <Compile Remove="Baselines/**/*.cs" />
    <Content Include="Baselines/Contract1/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines/Contract1/FrozenVendor.Contract99.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines/Contract1Net10/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines/Contract1Net10/FrozenVendor.Contract99Net10.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
