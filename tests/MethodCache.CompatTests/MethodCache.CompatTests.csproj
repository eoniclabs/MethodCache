<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <ProjectReference Include="../../src/MethodCache.Core/MethodCache.Core.csproj" />
    <!-- Deliberately binary references: ordinary builds/tests never rebuild the vendor baseline. -->
    <Reference Include="FrozenVendor.Contract1Final" HintPath="Baselines/Contract1Final/FrozenVendor.Contract1Final.dll" />
    <Reference Include="FrozenVendor.ThirdPartyFinal" HintPath="Baselines/Contract1Final/FrozenVendor.ThirdPartyFinal.dll" />
    <Compile Remove="Baselines/**/*.cs" />
    <Content Include="Baselines/Contract1FinalGeneratedApi.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines/Contract1Final/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines/Contract1Final/FrozenVendor.Contract99Final.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/MethodCache.Core/PublicAPI.Unshipped.txt" Link="CurrentGeneratedPublicAPI.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/MethodCache.Core/PublicAPI.Shipped.txt" Link="CurrentGeneratedPublicAPI.Shipped.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
