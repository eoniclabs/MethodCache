<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published with Native AOT in CI to prove AddMethodCache() works without reflection. Not part of the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MethodCache.Core\MethodCache.Core.csproj" />
    <ProjectReference Include="../../src/MethodCache.HttpCaching/MethodCache.HttpCaching.csproj" />
    <ProjectReference Include="..\MethodCache.AotSmokeTest.Vendor\MethodCache.AotSmokeTest.Vendor.csproj" />
    <Reference Include="FrozenVendor.Contract1Final" HintPath="../MethodCache.CompatTests/Baselines/Contract1Final/FrozenVendor.Contract1Final.dll" />
    <Reference Include="FrozenVendor.ThirdPartyFinal" HintPath="../MethodCache.CompatTests/Baselines/Contract1Final/FrozenVendor.ThirdPartyFinal.dll" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <ProjectReference Include="..\..\src\MethodCache.SourceGenerator\MethodCache.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
