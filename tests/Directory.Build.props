<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The libraries and tests target .NET 10. CI also exercises Windows, macOS, cultures,
    Native AOT and installed packages; older runtime targets are no longer supported.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.Contains('SmokeTest')) And '$(MSBuildProjectName)' != 'MethodCache.Docs.Tests'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
