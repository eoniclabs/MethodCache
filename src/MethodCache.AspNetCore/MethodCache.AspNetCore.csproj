<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TrackPublicApi>true</TrackPublicApi>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>EonicLabs</Authors>
    <Description>ASP.NET Core admin endpoints and health check for MethodCache: inspect statistics and entries, invalidate tags and clear the cache at runtime</Description>
    <PackageProjectUrl>https://github.com/eoniclabs/MethodCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eoniclabs/MethodCache</RepositoryUrl>
    <PackageTags>cache;methodcache;aspnetcore;admin;management;healthchecks</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MethodCache.Core\MethodCache.Core.csproj" />
  </ItemGroup>

</Project>
