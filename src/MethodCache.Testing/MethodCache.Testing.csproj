<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TrackPublicApi>true</TrackPublicApi>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MethodCache.Testing</PackageId>
    <Description>Test helpers for MethodCache: a fake clock, a recorder of loads and invalidations, and a check that every cache tag has an invalidation</Description>
    <PackageTags>cache;methodcache;testing;xunit;nunit;fake;timeprovider</PackageTags>
    <PackageProjectUrl>https://github.com/eoniclabs/MethodCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eoniclabs/MethodCache</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MethodCache.Core\MethodCache.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/TagPattern.cs" Link="Internal/TagPattern.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MethodCache.Testing.Tests" />
  </ItemGroup>

</Project>
