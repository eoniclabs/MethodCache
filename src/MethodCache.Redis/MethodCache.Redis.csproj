<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TrackPublicApi>true</TrackPublicApi>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MethodCache.Redis</PackageId>
    <Description>Redis as MethodCache's distributed cache, with a pub/sub backplane that keeps every instance's in-memory cache in sync</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.9.25" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MethodCache.Core\MethodCache.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MethodCache.Redis.Tests" />
    <InternalsVisibleTo Include="MethodCache.Redis.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../MethodCache.Core/Runtime/Distributed/LosslessWireText.cs" Link="Internal/LosslessWireText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/LosslessUtf16.cs" Link="Internal/LosslessUtf16.cs" />
  </ItemGroup>

</Project>
