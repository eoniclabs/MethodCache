<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TrackPublicApi>true</TrackPublicApi>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MethodCache.Serialization.MessagePack</PackageId>
    <Description>MessagePack serialization for MethodCache: compact binary values in Redis and SQL Server instead of the default System.Text.Json</Description>
    <PackageTags>cache;methodcache;messagepack;serialization;distributed-cache</PackageTags>
    <PackageProjectUrl>https://github.com/eoniclabs/MethodCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eoniclabs/MethodCache</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MethodCache.Core\MethodCache.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MethodCache.Core.Tests" />
    <InternalsVisibleTo Include="MethodCache.Docs.Tests" />
    <InternalsVisibleTo Include="MethodCache.Benchmarks" />
    <InternalsVisibleTo Include="MethodCache.Benchmarks.Tests" />
    <InternalsVisibleTo Include="MethodCache.Serialization.MessagePack.Tests" />
  </ItemGroup>

</Project>
