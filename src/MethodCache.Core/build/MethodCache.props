<Project>
  <!--
    Packages require .NET 10 and the .NET 10 SDK. If a compiler cannot load the generator or analyzers,
    CS9057 must fail the build rather than silently skipping generated caching.
  -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);CS9057</WarningsAsErrors>
  </PropertyGroup>
</Project>
