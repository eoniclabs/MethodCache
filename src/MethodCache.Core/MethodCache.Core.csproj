<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TrackPublicApi>true</TrackPublicApi>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!-- The one package users install: runtime library plus the source generator and analyzers -->
    <PackageId>MethodCache</PackageId>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>

    <!-- Enhanced NuGet Metadata for AI Discovery -->
    <Title>MethodCache - Declarative Caching for .NET</Title>
    <Description>Declarative caching for .NET: [Cache] attributes compiled by a source generator, tag invalidation, and an in-memory cache with optional Redis, SQL Server or PostgreSQL as a distributed cache</Description>
    <PackageTags>cache;caching;methodcache;memorycache;source-generator;attributes;declarative;method-caching;memoization;tag-invalidation;distributed-cache;native-aot</PackageTags>
    <RepositoryUrl>https://github.com/eoniclabs/MethodCache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eoniclabs/MethodCache</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" />
    <!-- The user documentation ships in the package, so a coding agent can read the docs of the installed version -->
    <None Include="..\..\docs\**\*.md" Exclude="..\..\docs\developer\**" Pack="true" PackagePath="docs" Visible="false" />
    <None Include="..\..\llms-full.txt" Pack="true" PackagePath="docs" Visible="false" />
    <!-- What changed in each version, and what to do when upgrading, next to the docs of that version -->
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="docs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MethodCache.Core.Tests" />
    <InternalsVisibleTo Include="MethodCache.Docs.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="MethodCache.AspNetCore.Tests" />
    <InternalsVisibleTo Include="MethodCache.OpenTelemetry.Tests" />
    <InternalsVisibleTo Include="MethodCache.Redis.Tests" />
    <InternalsVisibleTo Include="MethodCache.SqlServer.Tests" />
    <InternalsVisibleTo Include="MethodCache.Redis.IntegrationTests" />
    <InternalsVisibleTo Include="MethodCache.SqlServer.IntegrationTests" />
    <InternalsVisibleTo Include="MethodCache.PostgreSql.Tests" />
    <InternalsVisibleTo Include="MethodCache.PostgreSql.IntegrationTests" />
    <InternalsVisibleTo Include="MethodCache.HttpCaching.Tests" />
    <InternalsVisibleTo Include="MethodCache.HttpCaching.IntegrationTests" />
    <InternalsVisibleTo Include="MethodCache.Serialization.MessagePack.Tests" />

    <InternalsVisibleTo Include="MethodCache.SourceGenerator" />
    <InternalsVisibleTo Include="MethodCache.Benchmarks" />
    <InternalsVisibleTo Include="MethodCache.Benchmarks.Tests" />
    <InternalsVisibleTo Include="MethodCache.L2Bench" />
    <InternalsVisibleTo Include="MethodCache.SourceGenerator.IntegrationTests" />
    <InternalsVisibleTo Include="MethodCache.Redis" />
    <InternalsVisibleTo Include="MethodCache.Testing" />
    <InternalsVisibleTo Include="MethodCache.EntityFrameworkCore" />
    <InternalsVisibleTo Include="MethodCache.SqlServer" />
    <InternalsVisibleTo Include="MethodCache.PostgreSql" />
    <InternalsVisibleTo Include="MethodCache.AspNetCore" />
    <InternalsVisibleTo Include="MethodCache.OpenTelemetry" />
    <InternalsVisibleTo Include="MethodCache.HttpCaching" />
    <InternalsVisibleTo Include="MethodCache.Serialization.MessagePack" />
  </ItemGroup>

  <!--
    The generator, analyzers and code fixes ship inside this package under analyzers/dotnet/cs, so the compiler runs them for
    anyone who installs MethodCache. The references only order the build; they add no assembly or package dependency.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MethodCache.SourceGenerator\MethodCache.SourceGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\MethodCache.Analyzers\MethodCache.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\MethodCache.CodeFixes\MethodCache.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\MethodCache.SourceGenerator\bin\$(Configuration)\netstandard2.0\MethodCache.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\MethodCache.Analyzers\bin\$(Configuration)\netstandard2.0\MethodCache.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\MethodCache.CodeFixes\bin\$(Configuration)\netstandard2.0\MethodCache.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\MethodCache.targets" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/LosslessUtf16.cs" Link="Internal/LosslessUtf16.cs" />
    <Compile Include="../Shared/KeyCollectionState.cs" Link="Internal/KeyCollectionState.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/AssemblyIdentity.cs" Link="Internal/AssemblyIdentity.cs" />
    <Compile Include="../Shared/DurationParser.cs" Link="Internal/DurationParser.cs" />
  </ItemGroup>
</Project>
