<Project>
  <PropertyGroup>
    <Authors>EonicLabs</Authors>
    <RepositoryUrl>https://github.com/eoniclabs/MethodCache</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cache;caching;performance;method-caching;source-generator;roslyn-analyzer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Company>EonicLabs</Company>
    <PackageProjectUrl>https://github.com/eoniclabs/MethodCache</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Symbols, source link and docs, so users can step into MethodCache and get IntelliSense text -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>

    <!-- Common package versions -->
    <MicrosoftExtensionsVersion>9.0.7</MicrosoftExtensionsVersion>
    <SystemTextJsonVersion>9.0.7</SystemTextJsonVersion>
    <BenchmarkDotNetVersion>0.14.0</BenchmarkDotNetVersion>
    <XunitVersion>2.8.2</XunitVersion>
    <XunitRunnerVersion>2.8.2</XunitRunnerVersion>
    <MicrosoftTestSdkVersion>17.11.1</MicrosoftTestSdkVersion>
    <FluentAssertionsVersion>6.12.1</FluentAssertionsVersion>
    <StackExchangeRedisVersion>2.8.12</StackExchangeRedisVersion>
    <!-- Audit transitive dependencies as well, including test tooling. High and critical advisories stop restore. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Normalized paths in the shipped DLLs and PDBs; only on CI (build/ci/jobs.sh sets CI=true), so local debugging keeps real paths -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- XML docs for every project under src/; a public member without docs fails the build (CS1591) -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative($(MSBuildThisFileDirectory), $(MSBuildProjectDirectory)).StartsWith('src'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.6.133" PrivateAssets="all" />
  </ItemGroup>

  <!-- Items are evaluated after every property, so this sees a project's own PackageReadmeFile -->
  <ItemGroup Condition="'$(PackageReadmeFile)' == 'README.md'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath=""
          Link="README.md"
          Condition="!Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md') And '$(PackageReadmeFile)' == 'README.md'">
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Locks the public API of the shipped libraries. A project opts in with
    <TrackPublicApi>true</TrackPublicApi>; any public API change must then be
    recorded in its PublicAPI.Unshipped.txt (RS0016/RS0017 fail the build).
  -->
  <!-- Unconditional: properties are evaluated before the project sets TrackPublicApi, and the ids are inert without the analyzer. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- Optional-parameter overload rules would force API changes, not just tracking. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TrackPublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)libraries.globalconfig" />
  </ItemGroup>
</Project>
