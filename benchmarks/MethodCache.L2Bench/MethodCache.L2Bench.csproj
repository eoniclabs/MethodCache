<Project Sdk="Microsoft.NET.Sdk">

  <!-- Times the three distributed caches against each other; see README.md for how to run it -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MethodCache.Core/MethodCache.Core.csproj" />
    <ProjectReference Include="../../src/MethodCache.Redis/MethodCache.Redis.csproj" />
    <ProjectReference Include="../../src/MethodCache.SqlServer/MethodCache.SqlServer.csproj" />
    <ProjectReference Include="../../src/MethodCache.PostgreSql/MethodCache.PostgreSql.csproj" />
    <ProjectReference Include="../../src/MethodCache.SourceGenerator/MethodCache.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
