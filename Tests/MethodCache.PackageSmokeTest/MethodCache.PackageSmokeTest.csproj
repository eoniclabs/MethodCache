<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Installs the packed MethodCache package from ../../artifacts/packages, the way users get it, and proves the
    source generator inside it runs. Pack MethodCache.Core into that folder first. Not part of the solution.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Highest version in the folder, prerelease included; nuget.config maps MethodCache to that folder only -->
    <MethodCachePackageVersion Condition="'$(MethodCachePackageVersion)' == ''">*-*</MethodCachePackageVersion>
    <!-- A private package folder, so a re-pack with the same version is never served from the global cache -->
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MethodCache" Version="$(MethodCachePackageVersion)" />
  </ItemGroup>

</Project>
