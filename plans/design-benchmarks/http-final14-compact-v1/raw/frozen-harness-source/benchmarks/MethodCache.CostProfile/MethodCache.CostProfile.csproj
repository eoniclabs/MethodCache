<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles only the design harness, so cost-profile.sh can build the same profile against an older revision -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../MethodCache.Benchmarks/Comparison/GeneratedContractBenchmarks.cs" Link="Harness/GeneratedContractBenchmarks.cs" />
    <Compile Include="../MethodCache.Benchmarks/Microbenchmarks/DesignWorkloadBenchmarks.cs" Link="Harness/DesignWorkloadBenchmarks.cs" />
    <Compile Include="../MethodCache.Benchmarks/Microbenchmarks/HttpResponsePathBenchmarks.cs" Link="Harness/HttpResponsePathBenchmarks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.8.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MethodCache.Core/MethodCache.Core.csproj" />
    <ProjectReference Include="../../src/MethodCache.Redis/MethodCache.Redis.csproj" />
    <ProjectReference Include="../../src/MethodCache.SqlServer/MethodCache.SqlServer.csproj" />
    <ProjectReference Include="../../src/MethodCache.HttpCaching/MethodCache.HttpCaching.csproj" />
    <ProjectReference Include="../../src/MethodCache.OpenTelemetry/MethodCache.OpenTelemetry.csproj" />
    <ProjectReference Include="../../src/MethodCache.SourceGenerator/MethodCache.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
